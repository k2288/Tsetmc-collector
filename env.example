PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nestdb
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=tsetmc-collector:

RAW_DATA_ROOT=raw-data

TSETMC_ENABLED=true
TSETMC_BASE_URL=https://cdn.tsetmc.com
TSETMC_MARKET_WATCH_PATH=/api/ClosingPrice/GetMarketWatch?market=0&industrialGroup=
TSETMC_TIMEOUT_MS=10000

BRSAPI_ENABLED=false
BRSAPI_URL=https://BrsApi.ir/Api/Tsetmc/AllSymbols.php
BRSAPI_API_KEY=
BRSAPI_TIMEOUT_MS=10000

COLLECTOR_MAX_RETRIES=3
COLLECTOR_INITIAL_BACKOFF_MS=1000
COLLECTOR_BACKOFF_FACTOR=2
